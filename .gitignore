# ---- Raw and interim layers: not committed (size + pre-scrub state) ----
data/raw/*
!data/raw/.gitkeep
data/interim/*

# ---- Processed layer: committed (small, scrubbed) ----
# data/processed/ IS tracked.

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- Local scratch ----
*.db
*.sqlite3

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/
