# ---- Raw and interim layers: not committed (size + pre-scrub state) ----
data/raw/*
!data/raw/.gitkeep
data/interim/*

# ---- Processed layer: committed (small, scrubbed) ----
# data/processed/ IS tracked, except the transient pre-annotation pool.
data/processed/candidate_pool.csv

# ---- Release package: the generated contents are tracked, the zip is not ----
data/final/*.zip

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- Local scratch ----
*.db
*.sqlite3

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/
