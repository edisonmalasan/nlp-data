# Collector credentials — copy to .env and fill in. NEVER commit .env (see .gitignore).

# Meta Graph API — requires a Facebook Page access token for the target page.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Reddit Data API — requires a registered app (script type).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nlp-data-research/0.1 (university research contact)

# X API v2 — only if the team already has an approved project.
X_BEARER_TOKEN=
